# ─── Site ──────────────────────────────────────────────
NEXT_PUBLIC_SITE_URL=https://nammarcbhq.example.com

# ─── Sanity (https://sanity.io/manage) ─────────────────
# Leave PROJECT_ID empty to run the site on built-in sample data.
NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=production
NEXT_PUBLIC_SANITY_API_VERSION=2025-01-01
# Viewer token: lets the server read the private Instagram token doc
SANITY_API_READ_TOKEN=
# Editor token: used by the Instagram cron to save refreshed tokens
SANITY_API_WRITE_TOKEN=
# Any long random string. Paste the same value into the Sanity webhook.
SANITY_REVALIDATE_SECRET=

# ─── Instagram Graph API (Business/Creator accounts) ───
# Long-lived tokens (60 days). The cron job refreshes them automatically.
INSTAGRAM_TOKEN_MAIN=
INSTAGRAM_TOKEN_HUBBALLI=
INSTAGRAM_TOKEN_KOLAR=
INSTAGRAM_TOKEN_BELAGAVI=
# Fallback: Behold.so JSON feed URLs (used when a token is missing)
BEHOLD_FEED_MAIN=
BEHOLD_FEED_HUBBALLI=
BEHOLD_FEED_KOLAR=
BEHOLD_FEED_BELAGAVI=

# ─── Vercel Cron ───────────────────────────────────────
CRON_SECRET=

# ─── Resend (https://resend.com) ───────────────────────
RESEND_API_KEY=
# Must be on a domain verified in Resend
FORMS_FROM_EMAIL="Namma RCB HQ <noreply@your-domain.com>"
FORMS_TO_EMAIL=
